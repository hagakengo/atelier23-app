# Ollama 設定（ローカルビジョンモデル）
OLLAMA_API_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llava:7b-v1.6

# TCG Price API
TCG_PRICE_API_KEY=[ 新しいキーをここに貼り付け ]

# eBay API 認証情報（オプション）
EBAY_API_KEY=
EBAY_API_SECRET=
EBAY_REFRESH_TOKEN=

# アフィリエイト設定（オプション）
AMAZON_AFFILIATE_ID=atelier23-22
RAKUTEN_AFFILIATE_ID=
RAKUTEN_ROOM_ID=
EBAY_PARTNER_ID=

# Buffer API（X 自動投稿用、オプション）
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID=
