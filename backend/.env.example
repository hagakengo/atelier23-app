# eBay API 認証情報
# eBay Developer Account から取得後、以下を設定してください
EBAY_API_KEY=your_ebay_api_key_here
EBAY_API_SECRET=your_ebay_api_secret_here
EBAY_REFRESH_TOKEN=your_ebay_refresh_token_here

# Anthropic API キー（Claude Vision & 記事生成用）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# note API トークン
# note から取得したアクセストークン
NOTE_ACCESS_TOKEN=your_note_access_token_here

# Buffer API（X 自動投稿用）
# Buffer から取得したアクセストークン
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here
# Buffer 内の X プロフィール ID
BUFFER_PROFILE_ID=your_buffer_x_profile_id_here

# アフィリエイト設定
# Amazon Associates ID
AMAZON_AFFILIATE_ID=your_amazon_affiliate_id_here
# 楽天アフィリエイト ID
RAKUTEN_AFFILIATE_ID=your_rakuten_affiliate_id_here
# 楽天ルームID
RAKUTEN_ROOM_ID=your_rakuten_room_id_here
# eBay Partner ID
EBAY_PARTNER_ID=your_ebay_partner_id_here
